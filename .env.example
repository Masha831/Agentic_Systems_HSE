# LLM-провайдер: openrouter | yandex. Пусто — openrouter, если задан OPENROUTER_API_KEY, иначе yandex.
LLM_PROVIDER=
# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Пусто — deepseek/deepseek-v4.1-flash-1017 (DeepSeek V4.1 Flash, понимает и изображения).
# Для yandex пусто — YANDEX_MODEL.
LLM_MODEL=
# Пусто — https://openrouter.ai/api/v1 (для yandex — YANDEX_LLM_BASE_URL)
LLM_BASE_URL=
# Рассуждение DeepSeek: none (по умолчанию) | low | high | max | default (как задумал провайдер)
LLM_REASONING=none
# Необязательные заголовки атрибуции OpenRouter
OPENROUTER_REFERER=
OPENROUTER_TITLE=
# Своя модель для агента (пусто — LLM_MODEL)
INTERVIEWER_MODEL=
ARCHIVIST_MODEL=
EDITOR_MODEL=
# Фото-анализ. Пусто — тот же провайдер, что у LLM, и (для openrouter) та же модель.
VISION_PROVIDER=
VISION_MODEL=
VISION_BASE_URL=

# Yandex AI Studio — https://aistudio.yandex.ru/platform (LLM_PROVIDER=yandex и SpeechKit)
# Сервисный аккаунт с ролями ai.languageModels.user и ai.speechkit-stt.user / ai.speechkit-tts.user, API-ключ.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель без gpt://<folder>/. Проверены: yandexgpt-5.1/latest, yandexgpt-5-pro/latest, aliceai-llm/latest,
# deepseek-v4-flash/latest, deepseek-v4.1-flash/latest (yandexgpt/latest в нашем каталоге не открывается)
YANDEX_MODEL=yandexgpt-5.1/latest
YANDEX_LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# Мультимодальная модель Яндекса для фото (используется при vision-провайдере yandex)
YANDEX_VISION_MODEL=qwen3.6-35b-a3b
YANDEX_VISION_BASE_URL=https://ai.api.cloud.yandex.net/v1
TTS_VOICE=alena

# Голос. STT (запись по кнопке) и TTS (озвучка) — ElevenLabs или yandex; живой текст при записи всегда Yandex SpeechKit v3.
# https://elevenlabs.io/app/settings/api-keys (разрешения Speech to Text и Text to Speech)
ELEVENLABS_API_KEY=
# Голос для озвучки (id из https://elevenlabs.io/app/voice-library, с поддержкой русского). Пусто — озвучка недоступна.
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# elevenlabs | yandex. Пусто — elevenlabs, если задан ELEVENLABS_API_KEY, иначе yandex.
STT_PROVIDER=
TTS_PROVIDER=

# 1 — агенты и речь отвечают заглушками без обращения к LLM и Яндексу (удобно разрабатывать UI без ключей).
# Если нет ключа выбранного провайдера (openrouter: ключ; yandex: ключ и folder), мок включается автоматически.
MOCK=0

DB_PATH=backend/data/pomnu.sqlite3
MEDIA_DIR=backend/data/media

# --- Docker / публичный доступ (docker-compose.yml, Caddyfile) ---
# Пароль на весь сайт. Хэш: docker run --rm caddy:2 caddy hash-password
# ВАЖНО: хэш в одинарных кавычках, иначе docker compose съест символы «$».
BASIC_AUTH_USER=
BASIC_AUTH_HASH=''
# Доп. хосты для WebSocket живой расшифровки, через запятую (пусто — только хост из заголовка Host).
# Нужно, только если прокси подменяет Host: например pomnu.example.com
ALLOWED_ORIGINS=
# Именованный туннель Cloudflare для своего домена (make domain): токен из панели Zero Trust → Networks → Tunnels.
TUNNEL_TOKEN=
# ./Caddyfile.open — сайт без пароля (временно, для демо). Пусто — пароль включён (./Caddyfile).
CADDYFILE=
