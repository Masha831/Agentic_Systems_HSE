# Yandex AI Studio — https://aistudio.yandex.ru/platform
# Сервисный аккаунт с ролями ai.languageModels.user и ai.speechkit-stt.user / ai.speechkit-tts.user, API-ключ.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель без gpt://<folder>/. Проверены: yandexgpt-5.1/latest, yandexgpt-5-pro/latest, aliceai-llm/latest,
# deepseek-v4-flash/latest, deepseek-v4.1-flash/latest (yandexgpt/latest в нашем каталоге не открывается)
YANDEX_MODEL=yandexgpt-5.1/latest
# Своя модель для агента (пусто — YANDEX_MODEL)
INTERVIEWER_MODEL=
ARCHIVIST_MODEL=
EDITOR_MODEL=
YANDEX_LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# Мультимодальная модель для деталей фотографий (отдельно от интервьюера).
VISION_MODEL=qwen3.6-35b-a3b
YANDEX_VISION_BASE_URL=https://ai.api.cloud.yandex.net/v1
TTS_VOICE=alena

# 1 — агенты и речь отвечают заглушками без обращения к Яндексу (удобно разрабатывать UI без ключей).
# Если ключ не задан, мок включается автоматически.
MOCK=0

DB_PATH=backend/data/pomnu.sqlite3
MEDIA_DIR=backend/data/media

# --- Docker / публичный доступ (docker-compose.yml, Caddyfile) ---
# Пароль на весь сайт. Хэш: docker run --rm caddy:2 caddy hash-password
# ВАЖНО: хэш в одинарных кавычках, иначе docker compose съест символы «$».
BASIC_AUTH_USER=
BASIC_AUTH_HASH=''
# Доп. хосты для WebSocket живой расшифровки, через запятую (пусто — только хост из заголовка Host).
# Нужно, только если прокси подменяет Host: например pomnu.example.com
ALLOWED_ORIGINS=
