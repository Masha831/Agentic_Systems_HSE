# Yandex AI Studio — https://aistudio.yandex.ru/platform
# Сервисный аккаунт с ролями ai.languageModels.user и ai.speechkit-stt.user / ai.speechkit-tts.user, API-ключ.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель: yandexgpt/latest, yandexgpt-lite/latest, yandexgpt-5.1/latest, aliceai-llm и т.п. — без gpt://<folder>/
YANDEX_MODEL=yandexgpt/latest
YANDEX_LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
TTS_VOICE=alena

# 1 — агенты и речь отвечают заглушками без обращения к Яндексу (удобно разрабатывать UI без ключей).
# Если ключ не задан, мок включается автоматически.
MOCK=0

DB_PATH=backend/data/pomnu.sqlite3
MEDIA_DIR=backend/data/media
